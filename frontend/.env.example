# Default: browser calls same-origin /api/*; Next.js proxies to the local backend.
INSTALLDOCTOR_BACKEND_URL=http://127.0.0.1:8000
# Optional direct browser connection; backend CORS must allow the frontend origin:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Never put NEBIUS_API_KEY or other secrets in NEXT_PUBLIC_* variables.
