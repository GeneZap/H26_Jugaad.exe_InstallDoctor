# ============================================================
# InstallDoctor Frontend Configuration
# ============================================================
# Copy this file to .env.local and adjust values as needed.
#
# NEXT_PUBLIC_API_BASE_URL
#   The URL of the InstallDoctor FastAPI backend.
#   The backend serves at port 8000 by default.
#   CORS is pre-configured for localhost:3000 (Next.js dev).
#
# To connect to the backend:
#   1. cd backend/
#   2. pip install -e .
#   3. uvicorn install_doctor.api:app --reload --port 8000
#   4. Then run this frontend: npm run dev
# ============================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
