# Set these in your shell. This example file is not automatically loaded.
INSTALLDOCTOR_RUNNER=docker
INSTALLDOCTOR_AI_PROVIDER=hermes
INSTALLDOCTOR_MODEL=gemma4:26b-a4b-it-q4_K_M
INSTALLDOCTOR_OLLAMA_URL=http://127.0.0.1:11434
INSTALLDOCTOR_MODEL_SOURCE=https://ollama.com/library/gemma4:26b-a4b-it-q4_K_M
INSTALLDOCTOR_MODEL_LICENSE=Apache-2.0
INSTALLDOCTOR_MODEL_TIMEOUT=600
# Reviewed repositories only; NOT a security sandbox:
# INSTALLDOCTOR_RUNNER=trusted-local
# INSTALLDOCTOR_PYTHON=python
# Direct Ollama development mode does not claim Hermes participation:
# INSTALLDOCTOR_AI_PROVIDER=ollama

# Explicit hosted development mode (bypasses Hermes; no automatic fallback):
# INSTALLDOCTOR_AI_PROVIDER=nebius
# INSTALLDOCTOR_MODEL=nvidia/Nemotron-3_5-Lightning
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_API_KEY=  # Set privately in the shell, never commit a real key.
INSTALLDOCTOR_MAX_OUTPUT_TOKENS=8192
INSTALLDOCTOR_OLLAMA_THINK=false
